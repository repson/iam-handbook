---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import ArticleList from '../components/ArticleList.astro';
import { categories } from '../lib/categories';
import { articles, url, articleUrl, categoryUrl } from '../lib/content';
const entries = await articles();
const starts = ['fundamentals/what-is-iam', 'fundamentals/identities-accounts-credentials', 'fundamentals/authentication-and-authorization'];
---
<Layout>
  <div class="home page-wrap">
    <div class="eyebrow"><span class="status-dot"></span> AN OPEN FIELD GUIDE TO IAM</div>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><h1 id="hero-title">Identity,<br /><em>understood.</em></h1><p>A practical knowledge base for identity and access management. From the first principles to the systems that connect them.</p><div class="hero-actions"><a class="button button-primary" href={articleUrl('fundamentals/what-is-iam')}>Start with the basics <Icon name="arrow" size={18} /></a><a class="text-link" href="#explore">Explore the handbook <span>↗</span></a></div><div class="hero-meta"><span><Icon name="book" size={14} />{entries.length} articles</span><span class="meta-dot">·</span><span>Always evolving</span></div></div>
      <div class="identity-map" role="img" aria-label="A subject authenticates, a policy determines access, and a resource enforces the decision.">
        <div class="map-caption"><span>THE BIG PICTURE</span><span>01 — IAM</span></div>
        <div class="map-person"><span class="map-icon"><Icon name="identity" size={23} /></span><div><strong>Identity</strong><small>Who is requesting access?</small></div><span class="map-small-dot"></span></div>
        <div class="map-connector"><span></span><small>establish trust</small><span>↓</span></div>
        <div class="map-middle"><div><Icon name="check" size={18} /><strong>Authenticate</strong><small>Verify the subject</small></div><span>+</span><div><Icon name="nodes" size={18} /><strong>Authorize</strong><small>Evaluate the policy</small></div></div>
        <div class="map-connector"><span></span><small>enforce the decision</small><span>↓</span></div>
        <div class="map-resource"><Icon name="layers" size={23} /><div><strong>The right access</strong><small>To the right resource. At the right time.</small></div><span class="map-check"><Icon name="check" size={14} /></span></div>
        <div class="map-bottom"><span class="status-dot"></span> Govern the entire lifecycle <span>↺</span></div>
      </div>
    </section>
    <section class="start-banner"><span class="banner-symbol"><Icon name="nodes" size={23} /></span><div><strong>New to identity and access management?</strong><p>Take a guided route through the essentials. One concept at a time.</p></div><a href={url('learning-path/')}>Follow the learning path <Icon name="arrow" size={18} /></a></section>
    <section id="explore" class="explore-section" aria-labelledby="explore-title"><div class="section-heading"><div><div class="eyebrow">A MAP OF THE DISCIPLINE</div><h2 id="explore-title">Find your starting point.</h2></div><span class="section-aside">{categories.length} connected areas of knowledge</span></div><div class="category-grid">{categories.map((category, i) => <a class="category-card" href={categoryUrl(category.id)}><div class="card-top"><span class="category-icon"><Icon name={category.icon} size={22} /></span><span class="card-number">{String(i + 1).padStart(2, '0')}</span></div><h3>{category.name}</h3><p>{category.description}</p><div class="card-bottom"><span>{entries.filter(e => e.data.category === category.id).length} articles</span><Icon name="arrow" size={17} /></div></a>)}</div></section>
    <section class="essentials"><div class="section-heading"><div><div class="eyebrow">FIRST THINGS FIRST</div><h2>A few good places to begin.</h2></div><a class="text-link" href={categoryUrl('fundamentals')}>All fundamentals <Icon name="arrow" size={16} /></a></div><ArticleList entries={starts.map(id => entries.find(e => e.id === id)!)} numbered /></section>
    <section class="living-note"><div class="living-label"><span class="status-dot"></span> A LIVING HANDBOOK</div><h2>Knowledge grows.<br /><em>This handbook grows with it.</em></h2><p>A place to collect useful ideas, connect the dots, and build a clearer understanding of IAM. Starting with the foundations, expanding with every discovery.</p><a class="text-link" href={url('roadmap/')}>See what comes next <Icon name="arrow" size={17} /></a></section>
    <Footer />
  </div>
</Layout>
