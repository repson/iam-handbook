---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';
import { articles, articleUrl, categoryUrl, repository, readingMinutes } from '../../lib/content';
import { categories } from '../../lib/categories';
export async function getStaticPaths() { return (await articles()).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = await articles();
const position = entries.findIndex(e => e.id === entry.id);
const previous = entries[position - 1];
const next = entries[position + 1];
const category = categories.find(c => c.id === entry.data.category)!;
const editPath = entry.filePath || `content/${entry.id}.md`;
---
<Layout title={entry.data.title} description={entry.data.description} section={category.name}>
  <div class="article-shell"><div class="article-column"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={categoryUrl(category.id)}>{category.name}</a><Icon name="chevron" size={12} /><span>Handbook</span></nav><header class="article-header"><span class="pill">{entry.data.level}</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="article-meta"><span><Icon name="clock" size={14} />{readingMinutes(entry.body)} min read</span></div></header><article class="prose"><Content /></article><div class="article-feedback"><span>Knowledge is better when it is shared.</span><a href={`${repository}/edit/main/${editPath}`}>Improve this page <Icon name="northeast" size={14} /></a></div><nav class="article-pagination" aria-label="Article navigation">{previous ? <a href={articleUrl(previous.id)}><small>← PREVIOUS</small><strong>{previous.data.title}</strong></a> : <span></span>}{next && <a href={articleUrl(next.id)}><small>NEXT →</small><strong>{next.data.title}</strong></a>}</nav><Footer /></div><aside class="toc" aria-label="On this page"><div class="nav-label">ON THIS PAGE</div><nav>{headings.filter(h => h.depth === 2 || h.depth === 3).map(h => <a href={`#${h.slug}`} class:list={{ subheading: h.depth === 3 }}>{h.text}</a>)}</nav><div class="toc-note"><Icon name="leaf" size={18} /><p>Part of an evolving reference.</p><a href={`${repository}/blob/main/${editPath}`}>View Markdown <Icon name="northeast" size={12} /></a></div><a class="back-top" href="#main">Back to top ↑</a></aside></div>
</Layout>
